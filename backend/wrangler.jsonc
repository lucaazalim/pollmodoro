/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poll-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "dev": {
    "port": 8787,
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "FRONTEND_URL": "http://localhost:5173",
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PollDurableObject"],
    },
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "POLL_DURABLE_OBJECT",
        "class_name": "PollDurableObject",
      },
    ],
  },
  "env": {
    "production": {
      // Without this, Wrangler deploys `--env production` to a separate
      // "poll-backend-production" Worker with its own, empty Durable Objects.
      "name": "poll-backend",
      "vars": {
        "FRONTEND_URL": "https://pollmodoro.com",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "POLL_DURABLE_OBJECT",
            "class_name": "PollDurableObject",
          },
        ],
      },
      "routes": [
        {
          "pattern": "api.pollmodoro.com",
          "custom_domain": true,
        },
      ],
    },
  },
}
